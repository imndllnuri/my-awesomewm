/* Matches the AwesomeWM top bar: same dark translucent background + blur,
   same soft-white focus color, same rounded corners. */

* {
    bg-col:      #0f0f0f1a;
    bg-col-alt:  #0f0f0f4d;
    fg-col:      #ffffff;
    accent:      #ededed33;
    accent-fg:   #EDEDED;
    border-col:  #333333;

    background-color: transparent;
    text-color:  @fg-col;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    background-color: @bg-col;
    border: 1px;
    border-color: @border-col;
    border-radius: 12px;
    width: 600px;
    location: north;
    anchor: north;
    y-offset: 60px;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg-col-alt;
    text-color: @fg-col;
    border-radius: 8px;
    padding: 8px 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent-fg;
}

entry {
    text-color: @fg-col;
    placeholder: "Search...";
    placeholder-color: #ffffff88;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 4px;
}

element {
    background-color: transparent;
    text-color: @fg-col;
    border-radius: 8px;
    padding: 6px 10px;
}

element selected {
    background-color: @accent;
    text-color: @accent-fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element-icon {
    size: 20px;
}
